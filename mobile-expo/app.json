{
  "expo": {
    "name": "Fruit Slash AR",
    "slug": "fruit-slash-ar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F1A",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Fruit Slash AR precisa de acesso à câmera para a experiência de Realidade Aumentada (AR)."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F1A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Fruit Slash AR precisa de acesso à câmera para a experiência de Realidade Aumentada (AR)."
        }
      ],
      "expo-font"
    ]
  }
}
